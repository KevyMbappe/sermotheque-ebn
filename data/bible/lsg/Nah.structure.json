{
  "1": [
    {
      "type": "paragraph",
      "level": 0,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Oracle sur Ninive. Livre de la prophétie de Nahum, d’Elkosch.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "L’Éternel est un Dieu jaloux, il se venge;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "L’Éternel se venge, il est plein de fureur;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "L’Éternel se venge de ses adversaires,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "Il garde rancune à ses ennemis.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "L’Éternel est lent à la colère, il est grand par sa force;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Il ne laisse pas impuni.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "L’Éternel marche dans la tempête, dans le tourbillon;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Les nuées sont la poussière de ses pieds.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Il menace la mer et la dessèche,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Il fait tarir tous les fleuves;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Le Basan et le Carmel languissent,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "La fleur du Liban se flétrit.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Les montagnes s’ébranlent devant lui,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Et les collines se fondent;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "La terre se soulève devant sa face,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Le monde et tous ses habitants.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Qui résistera devant sa fureur?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Qui tiendra contre son ardente colère?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Sa fureur se répand comme le feu,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Et les rochers se brisent devant lui.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "L’Éternel est bon,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Il est un refuge au jour de la détresse;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Il connaît ceux qui se confient en lui.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Mais avec des flots qui déborderont",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Il détruira la ville,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Et il poursuivra ses ennemis jusque dans les ténèbres.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Que méditez-vous contre l’Éternel?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "C’est lui qui détruit.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "La détresse ne paraîtra pas deux fois.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Car entrelacés comme des épines,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Et comme ivres de leur vin,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Ils seront consumés",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Comme la paille sèche, entièrement.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "De toi est sorti",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Celui qui méditait le mal contre l’Éternel,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Celui qui avait de méchants desseins.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Ainsi parle l’Éternel: Quoique intacts et nombreux,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Ils seront moissonnés et disparaîtront.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Je veux t’humilier,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Pour ne plus avoir à t’humilier…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 13,
          "segments": [
            {
              "text": "Je briserai maintenant son joug de dessus toi,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 13,
          "segments": [
            {
              "text": "Et je romprai tes liens…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Voici ce qu’a ordonné sur toi l’Éternel:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Tu n’auras plus de descendants qui portent ton nom;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "J’enlèverai de la maison de ton dieu les images taillées ou en fonte;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Je préparerai ton sépulcre, car tu es trop léger.",
              "red": false
            }
          ]
        }
      ]
    }
  ],
  "2": [
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Voici sur les montagnes",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Les pieds du messager qui annonce la paix!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Célèbre tes fêtes, Juda, accomplis tes vœux!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Car le méchant ne passera plus au milieu de toi,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Il est entièrement exterminé…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "Le destructeur marche contre toi.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "Garde la forteresse!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "Veille sur la route! Affermis tes reins!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "Recueille toute ta force!…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Car l’Éternel rétablit la gloire de Jacob",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Et la gloire d’Israël,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Parce que les pillards les ont pillés",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Et ont détruit leurs ceps…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Les boucliers de ses héros sont rouges,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Les guerriers sont vêtus de pourpre;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Avec le fer qui étincelle apparaissent les chars,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Au jour qu’il a fixé pour la bataille,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Et les lances sont agitées.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Les chars s’élancent dans la campagne,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Se précipitent sur les places;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "A les voir, on dirait des flambeaux,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Ils courent comme des éclairs…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Il se souvient de ses vaillants hommes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Mais ils chancellent dans leur marche;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "On se hâte vers les murs,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Et l’on se prépare à la défense…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Les portes des fleuves sont ouvertes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Et le palais s’écroule!…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "C’en est fait: elle est mise à nu, elle est emmenée;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Ses servantes gémissent comme des colombes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Et se frappent la poitrine.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Ninive était jadis comme un réservoir plein d’eau…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Les voilà qui fuient…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Arrêtez! Arrêtez!…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
