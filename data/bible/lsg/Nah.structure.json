              "text": "Qui se posent sur les haies au temps de la froidure:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 17,
          "segments": [
            {
              "text": "Le soleil paraît, elles s’envolent,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 17,
          "segments": [
            {
              "text": "Et l’on ne connaît plus le lieu où elles étaient.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Tes bergers sommeillent, roi d’Assyrie,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Tes vaillants hommes reposent;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Ton peuple est dispersé sur les montagnes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Et nul ne le rassemble.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Il n’y a point de remède à ta blessure,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Ta plaie est mortelle.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Tous ceux qui entendront parler de toi",
              "red": false
            }
          ]
        }
