{
  "1": [
    {
      "type": "heading",
      "level": 2,
      "text": "Exhortation à rebâtir le temple de Jérusalem"
    },
    {
      "type": "paragraph",
      "level": 0,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "La seconde année du roi Darius, le premier jour du sixième mois, la parole de l’Éternel fut adressée par Aggée, le prophète, à Zorobabel, fils de Schealthiel, gouverneur de Juda, et à Josué, fils de Jotsadak, le souverain sacrificateur, en ces mots:",
              "red": false
            }
          ]
        },
        {
          "verse": 2,
          "segments": [
            {
              "text": "Ainsi parle l’Éternel des armées: Ce peuple dit: Le temps n’est pas venu, le temps de rebâtir la maison de l’Éternel.",
              "red": false
            }
          ]
        },
        {
          "verse": 3,
          "segments": [
            {
              "text": "C’est pourquoi la parole de l’Éternel leur fut adressée par Aggée, le prophète, en ces mots:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Est-ce le temps pour vous d’habiter vos demeures lambrissées,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Quand cette maison est détruite?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Ainsi parle maintenant l’Éternel des armées:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Considérez attentivement vos voies!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Vous semez beaucoup, et vous recueillez peu,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Vous mangez, et vous n’êtes pas rassasiés,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Vous buvez, et vous n’êtes pas désaltérés,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Vous êtes vêtus, et vous n’avez pas chaud;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Le salaire de celui qui est à gages tombe dans un sac percé.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Ainsi parle l’Éternel des armées:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Considérez attentivement vos voies!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Montez sur la montagne, apportez du bois,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Et bâtissez la maison:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "J’en aurai de la joie, et je serai glorifié,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Dit l’Éternel.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Vous comptiez sur beaucoup, et voici, vous avez eu peu;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Vous l’avez rentré chez vous, mais j’ai soufflé dessus.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Pourquoi? Dit l’Éternel des armées.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "A cause de ma maison, qui est détruite,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Tandis que vous vous empressez chacun pour sa maison.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "C’est pourquoi les cieux vous ont refusé la rosée,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Et la terre a refusé ses produits.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "J’ai appelé la sécheresse sur le pays, sur les montagnes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Sur le blé, sur le moût, sur l’huile,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Sur ce que la terre peut rapporter,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Sur les hommes et sur les bêtes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Et sur tout le travail des mains.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "level": 0,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Zorobabel, fils de Schealthiel, Josué, fils de Jotsadak, le souverain sacrificateur, et tout le reste du peuple, entendirent la voix de l’Éternel, leur Dieu, et les paroles d’Aggée, le prophète, selon la mission que lui avait donnée l’Éternel, leur Dieu. Et le peuple fut saisi de crainte devant l’Éternel.",
              "red": false
            }
          ]
        },
        {
          "verse": 13,
          "segments": [
            {
              "text": "Aggée, envoyé de l’Éternel, dit au peuple, d’après l’ordre de l’Éternel: Je suis avec vous, dit l’Éternel.",
              "red": false
            }
          ]
        },
        {
          "verse": 14,
          "segments": [
            {
              "text": "L’Éternel réveilla l’esprit de Zorobabel, fils de Schealthiel, gouverneur de Juda, et l’esprit de Josué, fils de Jotsadak, le souverain sacrificateur, et l’esprit de tout le reste du peuple. Ils vinrent, et ils se mirent à l’œuvre dans la maison de l’Éternel des armées, leur Dieu,",
              "red": false
            }
          ]
        },
        {
          "verse": 15,
          "segments": [
            {
              "text": "le vingt-quatrième jour du sixième mois, la seconde année du roi Darius.",
              "red": false
            }
          ]
        }
      ]
    }
  ],
  "2": [
    {
      "type": "heading",
      "level": 2,
      "text": "La gloire du second temple"
    },
    {
      "type": "paragraph",
      "level": 0,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Le vingt et unième jour du septième mois, la parole de l’Éternel se révéla par Aggée, le prophète, en ces mots:",
              "red": false
            }
          ]
        },
        {
          "verse": 2,
          "segments": [
            {
              "text": "Parle à Zorobabel, fils de Schealthiel, gouverneur de Juda, à Josué, fils de Jotsadak, le souverain sacrificateur, et au reste du peuple, et dis-leur:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Quel est parmi vous le survivant",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Qui ait vu cette maison dans sa gloire première?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Et comment la voyez-vous maintenant?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Telle qu’elle est, ne paraît-elle pas comme rien à vos yeux?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Maintenant fortifie-toi, Zorobabel! Dit l’Éternel.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Fortifie-toi, Josué, fils de Jotsadak, souverain sacrificateur!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Fortifie-toi, peuple entier du pays! Dit l’Éternel.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Et travaillez!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Car je suis avec vous,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Dit l’Éternel des armées.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Je reste fidèle à l’alliance que j’ai faite avec vous",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Quand vous sortîtes de l’Égypte,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Et mon esprit est au milieu de vous;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Ne craignez pas!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Car ainsi parle l’Éternel des armées:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Encore un peu de temps,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Et j’ébranlerai les cieux et la terre,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "La mer et le sec;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "J’ébranlerai toutes les nations;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Les trésors de toutes les nations viendront,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Et je remplirai de gloire cette maison,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Dit l’Éternel des armées.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "L’argent est à moi, et l’or est à moi,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Dit l’Éternel des armées.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "La gloire de cette dernière maison sera plus grande",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Que celle de la première,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Dit l’Éternel des armées;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Et c’est dans ce lieu que je donnerai la paix,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Dit l’Éternel des armées.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Bénédiction promise"
    },
    {
      "type": "paragraph",
      "level": 0,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Le vingt-quatrième jour du neuvième mois, la seconde année de Darius, la parole de l’Éternel se révéla par Aggée, le prophète, en ces mots:",
              "red": false
            }
          ]
        },
        {
          "verse": 11,
          "segments": [
            {
              "text": "Ainsi parle l’Éternel des armées: Propose aux sacrificateurs cette question sur la loi:",
              "red": false
            }
          ]
        },
        {
          "verse": 12,
          "segments": [
            {
              "text": "Si quelqu’un porte dans le pan de son vêtement de la chair consacrée, et qu’il touche avec son vêtement du pain, des mets, du vin, de l’huile, ou un aliment quelconque, ces choses seront-elles sanctifiées? Les sacrificateurs répondirent: Non!",
              "red": false
            }
          ]
        },
        {
          "verse": 13,
          "segments": [
            {
              "text": "Et Aggée dit: Si quelqu’un souillé par le contact d’un cadavre touche toutes ces choses, seront-elles souillées? Les sacrificateurs répondirent: Elles seront souillées.",
              "red": false
            }
          ]
        },
        {
          "verse": 14,
          "segments": [
            {
              "text": "Alors Aggée, reprenant la parole, dit:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Tel est ce peuple, telle est cette nation devant moi, dit l’Éternel,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Telles sont toutes les œuvres de leurs mains;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Ce qu’ils m’offrent là est souillé.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 15,
          "segments": [
            {
              "text": "Considérez donc attentivement",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 15,
          "segments": [
            {
              "text": "Ce qui s’est passé jusqu’à ce jour,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 15,
          "segments": [
            {
              "text": "Avant qu’on eût mis pierre sur pierre au temple de l’Éternel!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Alors, quand on venait à un tas de vingt mesures,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Il n’y en avait que dix;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Quand on venait à la cuve pour puiser cinquante mesures,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Il n’y en avait que vingt.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 17,
          "segments": [
            {
              "text": "Je vous ai frappés par la rouille et par la nielle, et par la grêle;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 17,
          "segments": [
            {
              "text": "J’ai frappé tout le travail de vos mains.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 17,
          "segments": [
            {
              "text": "Malgré cela, vous n’êtes pas revenus à moi, dit l’Éternel.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Considérez attentivement",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Ce qui s’est passé jusqu’à ce jour,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Jusqu’au vingt-quatrième jour du neuvième mois,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Depuis le jour où le temple de l’Éternel a été fondé,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Considérez-le attentivement!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Y avait-il encore de la semence dans les greniers?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Même la vigne, le figuier, le grenadier et l’olivier,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "N’ont rien rapporté.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Mais dès ce jour je répandrai ma bénédiction.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Destruction des ennemis, et élévation de Zorobabel"
    },
    {
      "type": "paragraph",
      "level": 0,
      "content": [
        {
          "verse": 20,
          "segments": [
            {
              "text": "La parole de l’Éternel fut adressée pour la seconde fois à Aggée, le vingt-quatrième jour du mois, en ces mots:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 21,
          "segments": [
            {
              "text": "Parle à Zorobabel, gouverneur de Juda, et dis:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 21,
          "segments": [
            {
              "text": "J’ébranlerai les cieux et la terre;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 22,
          "segments": [
            {
              "text": "Je renverserai le trône des royaumes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 22,
          "segments": [
            {
              "text": "Je détruirai la force des royaumes des nations,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 22,
          "segments": [
            {
              "text": "Je renverserai les chars et ceux qui les montent;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 22,
          "segments": [
            {
              "text": "Les chevaux et leurs cavaliers seront abattus,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 22,
          "segments": [
            {
              "text": "L’un par l’épée de l’autre.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 23,
          "segments": [
            {
              "text": "En ce jour-là, dit l’Éternel des armées,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 23,
          "segments": [
            {
              "text": "Je te prendrai, Zorobabel, fils de Schealthiel,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 23,
          "segments": [
            {
              "text": "Mon serviteur, dit l’Éternel,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 23,
          "segments": [
            {
              "text": "Et je te garderai comme un sceau;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 23,
          "segments": [
            {
              "text": "Car je t’ai choisi, dit l’Éternel des armées.",
              "red": false
            }
          ]
        }
      ]
    }
  ]
}
