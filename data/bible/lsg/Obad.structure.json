{
  "1": [
    {
      "type": "heading",
      "level": 2,
      "text": "Prophétie sur la ruine d’Édom"
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Prophétie d’Abdias.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Ainsi parle le Seigneur, l’Éternel, sur Édom:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Nous avons appris une nouvelle de la part de l’Éternel,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Et un messager a été envoyé parmi les nations:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 1,
          "segments": [
            {
              "text": "Levez-vous, marchons contre Édom pour lui faire la guerre!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "Voici, je te rendrai petit parmi les nations,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 2,
          "segments": [
            {
              "text": "Tu seras l’objet du plus grand mépris.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "L’orgueil de ton cœur t’a égaré,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Toi qui habites le creux des rochers,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Qui t’assieds sur les hauteurs,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Et qui dis en toi-même:",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 3,
          "segments": [
            {
              "text": "Qui me précipitera jusqu’à terre?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Quand tu placerais ton nid aussi haut que celui de l’aigle,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Quand tu le placerais parmi les étoiles,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 4,
          "segments": [
            {
              "text": "Je t’en précipiterai, dit l’Éternel.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Si des voleurs, des pillards, viennent de nuit chez toi,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Comme te voilà dévasté!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Mais enlèvent-ils plus qu’ils ne peuvent?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Si des vendangeurs viennent chez toi,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 5,
          "segments": [
            {
              "text": "Ne laissent-ils rien à grappiller?…",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Ah! Comme Ésaü est fouillé!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 6,
          "segments": [
            {
              "text": "Comme ses trésors sont découverts!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Tous tes alliés t’ont chassé jusqu’à la frontière,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Tes amis t’ont joué, t’ont dominé,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Ceux qui mangeaient ton pain t’ont dressé des pièges,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 7,
          "segments": [
            {
              "text": "Et tu n’as pas su t’en apercevoir!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "N’est-ce pas en ce jour, dit l’Éternel,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Que je ferai disparaître d’Édom les sages,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 8,
          "segments": [
            {
              "text": "Et de la montagne d’Ésaü l’intelligence?",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Tes guerriers, ô Théman, seront dans l’épouvante,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 9,
          "segments": [
            {
              "text": "Car tous ceux de la montagne d’Ésaü périront dans le carnage.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "A cause de ta violence contre ton frère Jacob,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Tu seras couvert de honte,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 10,
          "segments": [
            {
              "text": "Et tu seras exterminé pour toujours.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Le jour où tu te tenais en face de lui,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Le jour où des étrangers emmenaient captive son armée,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Où des étrangers entraient dans ses portes,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Et jetaient le sort sur Jérusalem,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 11,
          "segments": [
            {
              "text": "Toi aussi tu étais comme l’un d’eux.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Ne repais pas ta vue du jour de ton frère, du jour de son malheur,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Ne te réjouis pas sur les enfants de Juda au jour de leur ruine,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 12,
          "segments": [
            {
              "text": "Et n’ouvre pas une grande bouche au jour de la détresse!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 13,
          "segments": [
            {
              "text": "N’entre pas dans les portes de mon peuple au jour de sa ruine,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 13,
          "segments": [
            {
              "text": "Ne repais pas ta vue de son malheur au jour de sa ruine,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 13,
          "segments": [
            {
              "text": "Et ne porte pas la main sur ses richesses au jour de sa ruine!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Ne te tiens pas au carrefour pour exterminer ses fuyards,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 14,
          "segments": [
            {
              "text": "Et ne livre pas ses réchappés au jour de la détresse!",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 15,
          "segments": [
            {
              "text": "Car le jour de l’Éternel est proche, pour toutes les nations;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 15,
          "segments": [
            {
              "text": "Il te sera fait comme tu as fait,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 15,
          "segments": [
            {
              "text": "Tes œuvres retomberont sur ta tête.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Car, comme vous avez bu sur ma montagne sainte,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Ainsi toutes les nations boiront sans cesse;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Elles boiront, elles avaleront,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 16,
          "segments": [
            {
              "text": "Et elles seront comme si elles n’avaient jamais été.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 17,
          "segments": [
            {
              "text": "Mais le salut sera sur la montagne de Sion, elle sera sainte,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 17,
          "segments": [
            {
              "text": "Et la maison de Jacob reprendra ses possessions.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "La maison de Jacob sera un feu, et la maison de Joseph une flamme;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Mais la maison d’Ésaü sera du chaume,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Qu’elles allumeront et consumeront;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Et il ne restera rien de la maison d’Ésaü,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 18,
          "segments": [
            {
              "text": "Car l’Éternel a parlé.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Ceux du midi posséderont la montagne d’Ésaü,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Et ceux de la plaine le pays des Philistins;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Ils posséderont le territoire d’Éphraïm et celui de Samarie;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 19,
          "segments": [
            {
              "text": "Et Benjamin possédera Galaad.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 20,
          "segments": [
            {
              "text": "Les captifs de cette armée des enfants d’Israël",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 20,
          "segments": [
            {
              "text": "Posséderont le pays occupé par les Cananéens jusqu’à Sarepta,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 20,
          "segments": [
            {
              "text": "Et les captifs de Jérusalem qui sont à Sepharad",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 20,
          "segments": [
            {
              "text": "Posséderont les villes du midi.",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 21,
          "segments": [
            {
              "text": "Des libérateurs monteront sur la montagne de Sion,",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 21,
          "segments": [
            {
              "text": "Pour juger la montagne d’Ésaü;",
              "red": false
            }
          ]
        }
      ]
    },
    {
      "type": "poetry",
      "level": 1,
      "content": [
        {
          "verse": 21,
          "segments": [
            {
              "text": "Et à l’Éternel appartiendra le règne.",
              "red": false
            }
          ]
        }
      ]
    }
  ]
}
