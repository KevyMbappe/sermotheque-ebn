# Copy to .env and fill in. .env is gitignored (never commit real secrets).
# The enrich step (pipeline/enrich.py) reads ANTHROPIC_API_KEY from the environment;
# build_entry.py auto-loads this .env when run as a CLI.

# Claude API key for the enrichment step (~$0.078/sermon on claude-sonnet-4-6 with the
# full schema; claude-haiku-4-5 fallback ≈ ⅓ — see docs/ENRICHMENT-MODEL.md).
# Leave blank to run the deterministic steps only (parse + transcribe) and inject your own enrich fn.
ANTHROPIC_API_KEY=

# --- optional overrides (defaults are fine) ---
# SERMO_YTDLP=/abs/path/to/yt-dlp          # default: ./.venv/bin/yt-dlp
# SERMO_MLX_WHISPER=/abs/path/to/mlx_whisper
