# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets / local config — real .env is private; .env.example is committed as the template.
.env

# Operational run logs (the enrichment pass appends here)
logs/

# OS
.DS_Store
Thumbs.db

# Transient media cache — audio is regenerable via yt-dlp; never commit it.
# (Transcripts ARE committed, under data/catalog/transcripts/.)
cache/
*.mp3
*.m4a
*.wav

# Réglages locaux de l'agent (launch.json est partagé, pas les préférences machine)
.claude/settings.local.json
.claude/worktrees/
# État d'interface Xcode (binaire, propre à chaque machine)
**/xcuserdata/
